# Base URL of the existing Mayim Chaim / Otzaria API.
OTZARIA_BASE_URL=https://otzaria.duckdns.org

# Set the shared UID provided by the owner on the server only. Never commit the actual value.
OTZARIA_UID=replace-with-owner-provided-uid

# Bind locally; Nginx should proxy public /mcp to this port.
HOST=127.0.0.1
PORT=3010

# Upstream request timeout in milliseconds.
OTZARIA_TIMEOUT_MS=20000

# Basic per-IP request limit at the MCP layer (in-memory, per process).
MCP_RATE_LIMIT_PER_MINUTE=90
